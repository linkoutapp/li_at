{
  "name": "Linkout Extension",
  "version": "0.9",
  "description": "Linkout Extension to access cookie session",
  "permissions": [
    "cookies"
  ],
  "icons": {
    "16": "linkout.png",
    "48": "linkout.png",
    "128": "linkout.png"
  },
  "manifest_version": 3,
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_icon": "linkout.png",
    "default_popup": "index.html"
  }
}
